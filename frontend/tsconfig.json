{
  "extends": "frappe-ui/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@arcade": ["../arcade/index.ts"],
      "@arcade/*": ["../arcade/*"],
      "vue": ["./node_modules/vue"],
      "vue/*": ["./node_modules/vue/*"],
      "frappe-ui": ["./node_modules/frappe-ui/src/index.ts"],
      "frappe-ui/*": ["./node_modules/frappe-ui/*"],
      "phaser": ["./node_modules/phaser"],
      "phaser/*": ["./node_modules/phaser/*"],
      "socket.io-client": ["./node_modules/socket.io-client"],
      "vue-router": ["./node_modules/vue-router"],
      "vite": ["./node_modules/vite/dist/node/index.d.ts"]
    },
    "types": ["unplugin-icons/types/vue"]
  },
  "include": ["./src/**/*", "../arcade/**/*", "vite/client", "./vite.config.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
